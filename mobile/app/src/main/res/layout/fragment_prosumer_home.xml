<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface_light" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_4">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_solar_hero" android:orientation="vertical"
            android:padding="@dimen/space_6">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="SMART SOLAR / PROSUMER" android:textColor="@color/solar_accent"
                android:textSize="11sp" android:letterSpacing="0.1" />
            <TextView android:id="@+id/prosumer_welcome" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4"
                android:text="@string/prosumer_foundation_title"
                android:textColor="@color/solar_on_brand" android:textSize="26sp"
                android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/role_foundation_message"
                android:textColor="@color/solar_on_brand" android:textSize="14sp" />
            <TextView android:id="@+id/prosumer_account_status"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/prosumer_deactivation_request"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4" android:background="@color/status_warning_bg"
            android:padding="@dimen/space_4" android:text="@string/deactivation_request_pending"
            android:textColor="@color/status_warning" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6" android:text="@string/reservation_summary_title"
            android:textAppearance="@style/TextAppearance.Solar.SectionTitle" />
        <ProgressBar android:id="@+id/reservation_summary_loading"
            style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
            android:layout_height="3dp" android:layout_marginTop="@dimen/space_3"
            android:indeterminate="true" />
        <LinearLayout android:id="@+id/reservation_summary_content"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3" android:orientation="horizontal"
            android:visibility="gone">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Solar.Card"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="@dimen/space_2">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_4">
                    <TextView android:id="@+id/pending_reservation_count"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="32sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/pending_reservations_label"
                        android:textAppearance="@style/TextAppearance.Solar.Supporting" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Solar.Card"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="@dimen/space_2">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_4">
                    <TextView android:id="@+id/approved_future_reservation_count"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="32sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/approved_upcoming_label"
                        android:textAppearance="@style/TextAppearance.Solar.Supporting" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <TextView android:id="@+id/reservation_summary_zero"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="No pending or upcoming bookings. Find a station to get started."
            android:textAppearance="@style/TextAppearance.Solar.Supporting"
            android:visibility="gone" />
        <TextView android:id="@+id/reservation_summary_error"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3" android:background="@drawable/bg_solar_notice"
            android:padding="@dimen/space_4" android:text="@string/reservation_summary_unavailable"
            android:textAppearance="@style/TextAppearance.Solar.Supporting" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/reservation_summary_retry"
            style="@style/Widget.Solar.Button.Text" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/retry_action"
            android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6" android:text="What would you like to do?"
            android:textAppearance="@style/TextAppearance.Solar.SectionTitle" />
        <com.google.android.material.button.MaterialButton android:id="@+id/browse_stations_button"
            style="@style/Widget.Solar.Button.Primary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3"
            android:text="Find a station" />
        <com.google.android.material.button.MaterialButton android:id="@+id/my_bookings_button"
            style="@style/Widget.Solar.Button.Secondary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2"
            android:text="My bookings" />
        <com.google.android.material.button.MaterialButton android:id="@+id/profile_button"
            style="@style/Widget.Solar.Button.Text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2"
            android:text="@string/profile_action" />
        <com.google.android.material.button.MaterialButton android:id="@+id/logout_button"
            style="@style/Widget.Solar.Button.Text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2"
            android:text="@string/logout_action" />
    </LinearLayout>
</ScrollView>
