<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:orientation="vertical">

    <TextView
        android:id="@+id/stations_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Find a station"
        android:textColor="@color/text_primary"
        android:textAppearance="@style/TextAppearance.Solar.SectionTitle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/station_location_notice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/station_location_action"
            style="@style/Widget.Solar.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/station_cache_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text_primary"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/station_map_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/station_map_height"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_solar_notice"
        android:clipToOutline="true">

        <org.osmdroid.views.MapView
            android:id="@+id/station_map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <TextView android:id="@+id/station_map_loading"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@color/solar_surface_muted"
            android:gravity="center" android:text="Loading stations…"
            android:textAppearance="@style/TextAppearance.Solar.Supporting"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stations_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="@dimen/space_2" />

        <include layout="@layout/include_solar_loading_list"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="top" android:visibility="gone" />

        <LinearLayout
            android:id="@+id/error_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/error_message" android:accessibilityLiveRegion="polite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/status_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retry" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty_state_text"
            android:drawableTop="@drawable/ic_solar_station"
            android:drawableTint="@color/text_secondary"
            android:drawablePadding="@dimen/space_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No active stations are available. Try again when your connection or location changes."
            android:gravity="center"
            android:padding="@dimen/space_6"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
