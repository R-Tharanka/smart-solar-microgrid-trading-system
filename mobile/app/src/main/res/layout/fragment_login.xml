<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface_light" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="@dimen/space_4"
        android:paddingTop="@dimen/space_8" android:paddingBottom="@dimen/space_6">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_solar_hero" android:orientation="vertical"
            android:padding="@dimen/space_6">
            <ImageView android:layout_width="64dp" android:layout_height="64dp"
                android:src="@drawable/app_logo" android:contentDescription="@null" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6" android:text="@string/app_name"
                android:textColor="@color/solar_on_brand" android:textSize="28sp"
                android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="Connected energy, wherever you are."
                android:textColor="@color/solar_on_brand" android:textSize="14sp" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Solar.Card" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/space_6">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/login_title" android:textAppearance="@style/TextAppearance.Solar.ScreenTitle" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="Prosumer and Grid Operator access"
                    android:textAppearance="@style/TextAppearance.Solar.Supporting" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/identifier_layout" style="@style/Widget.Solar.Input"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6" android:hint="@string/identifier_label">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/identifier_input" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="textEmailAddress"
                        android:maxLength="320" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/password_layout" style="@style/Widget.Solar.Input"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3" android:hint="@string/password_label"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password_input" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="textPassword"
                        android:maxLength="128" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/login_error" android:accessibilityLiveRegion="polite" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4"
                    android:background="@color/status_error_bg" android:padding="@dimen/space_4"
                    android:textColor="@color/status_error" android:visibility="gone" />
                <ProgressBar android:id="@+id/login_progress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="3dp"
                    android:layout_marginTop="@dimen/space_4" android:indeterminate="true"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login_button" style="@style/Widget.Solar.Button.Primary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6" android:text="@string/login_action" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/register_button" style="@style/Widget.Solar.Button.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3" android:text="@string/register_link" />
    </LinearLayout>
</ScrollView>
