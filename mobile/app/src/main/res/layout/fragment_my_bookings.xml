<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Your reservations"
        android:textColor="@color/text_primary"
        android:textAppearance="@style/TextAppearance.Solar.SectionTitle" />

    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Solar.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:hint="@string/search_bookings_hint"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/booking_search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/booking_category_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:checkedButton="@id/bookings_all_filter"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bookings_all_filter"
                style="@style/Widget.Solar.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bookings_all_filter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bookings_pending_filter"
                style="@style/Widget.Solar.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bookings_pending_filter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bookings_current_filter"
                style="@style/Widget.Solar.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bookings_current_filter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bookings_upcoming_filter"
                style="@style/Widget.Solar.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bookings_upcoming_filter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bookings_history_filter"
                style="@style/Widget.Solar.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bookings_history_filter" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bookings_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="@dimen/space_2" />

        <include layout="@layout/include_solar_loading_list"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="top" android:visibility="gone" />

        <LinearLayout
            android:id="@+id/error_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/error_message" android:accessibilityLiveRegion="polite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/status_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retry" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty_state_text"
            android:drawableTop="@drawable/ic_solar_calendar"
            android:drawableTint="@color/text_secondary"
            android:drawablePadding="@dimen/space_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No bookings match this view. Try another category or clear your search."
            android:gravity="center"
            android:padding="@dimen/space_6"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
