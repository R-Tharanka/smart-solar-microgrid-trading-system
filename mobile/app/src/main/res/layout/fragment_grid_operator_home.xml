<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface_light" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_4">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_solar_hero" android:orientation="vertical"
            android:padding="@dimen/space_6">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="SMART SOLAR / OPERATIONS" android:textColor="@color/solar_accent"
                android:textSize="11sp" android:letterSpacing="0.1" />
            <TextView android:id="@+id/operator_welcome" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4"
                android:text="Energy operations" android:textColor="@color/solar_on_brand"
                android:textSize="26sp" android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="Verify energy transfers and inspect station information."
                android:textColor="@color/solar_on_brand" android:textSize="14sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6" android:text="Priority action"
            android:textAppearance="@style/TextAppearance.Solar.SectionTitle" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/scan_qr_card"
            style="@style/Widget.Solar.Card" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3"
            android:clickable="true" android:focusable="true"
            android:contentDescription="Scan transaction QR">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/space_5">
                <ImageView android:layout_width="40dp" android:layout_height="40dp"
                    android:src="@drawable/ic_solar_scan" android:tint="@color/status_success"
                    android:contentDescription="@null" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4" android:text="Scan transaction QR"
                    android:textAppearance="@style/TextAppearance.Solar.CardTitle" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="Verify a Prosumer QR before recording the energy transfer."
                    android:textAppearance="@style/TextAppearance.Solar.Supporting" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4" android:text="Open scanner  &#8594;"
                    android:textColor="@color/status_success" android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6" android:text="Station network"
            android:textAppearance="@style/TextAppearance.Solar.SectionTitle" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/station_map_card"
            style="@style/Widget.Solar.Card" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3"
            android:clickable="true" android:focusable="true"
            android:contentDescription="Monitor station network">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/space_5">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Monitor station network"
                    android:textAppearance="@style/TextAppearance.Solar.CardTitle" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="View active stations and their operating information."
                    android:textAppearance="@style/TextAppearance.Solar.Supporting" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/logout_button"
            style="@style/Widget.Solar.Button.Text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6"
            android:text="@string/logout_action" />
    </LinearLayout>
</ScrollView>
