<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="@dimen/space_6">
    <TextView android:id="@+id/station_dialog_code" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Solar.Code" />
    <TextView android:id="@+id/station_dialog_status" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" />
    <TextView android:id="@+id/station_dialog_address" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_5"
        android:textAppearance="@style/TextAppearance.Solar.Body" />
    <TextView android:id="@+id/station_dialog_capacity" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4"
        android:textAppearance="@style/TextAppearance.Solar.Supporting" />
    <TextView android:id="@+id/station_dialog_hours" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3"
        android:textAppearance="@style/TextAppearance.Solar.Supporting" />
</LinearLayout>
