# Copy this file to .env and replace every blank secret before starting the API.
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE_NAME=smart_solar_microgrid
JWT_SIGNING_KEY=

# Enable only for the first startup. Disable it after the first Backoffice account exists.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
